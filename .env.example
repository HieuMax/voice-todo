NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Server-only. Enables cloud speech-to-text (Whisper) for better
# accuracy than the browser Web Speech API. Leave blank to use the browser API.
# OpenAI: WHISPER_API_KEY=sk-...            (paid, ~$0.006/min)
# Groq:   WHISPER_API_KEY=gsk_...
#         WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
#         WHISPER_MODEL=whisper-large-v3
WHISPER_API_KEY=
WHISPER_API_URL=
WHISPER_MODEL=

# Anti-spam for the feedback form (optional, recommended in production).
# Cloudflare Turnstile: https://developers.cloudflare.com/turnstile/get-started/
# The site key is public; the secret key is server-only. Leave both blank to
# disable CAPTCHA (bots are then only slowed by rate limiting + honeypot).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared rate-limit / dedupe store (optional, recommended for multiple instances).
# Upstash Redis REST: https://upstash.com/docs/redis/features/restapi
# Server-only. Leave blank to fall back to an in-process store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Server-only. Discord webhook to get notified when a new user
# registers or someone sends feedback. Server Settings → Integrations → Webhooks.
# Leave blank to disable notifications.
DISCORD_WEBHOOK_URL=
#