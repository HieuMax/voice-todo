NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Server-only. Enables cloud speech-to-text (Whisper) for better
# accuracy than the browser Web Speech API. Leave blank to use the browser API.
# OpenAI: WHISPER_API_KEY=sk-...            (paid, ~$0.006/min)
# Groq:   WHISPER_API_KEY=gsk_...
#         WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
#         WHISPER_MODEL=whisper-large-v3
WHISPER_API_KEY=
WHISPER_API_URL=
WHISPER_MODEL=
